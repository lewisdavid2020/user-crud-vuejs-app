    {
      "name": "02 · Autenticación",
      "description": "Login con JWT y comprobaciones de acceso sin token.",
      "item": [
        {
          "name": "Login ADMIN (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve un token Bearer', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.accessToken.length).to.be.greaterThan(20);",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.expiresIn).to.be.above(0);",
                  "});",
                  "",
                  "const payload = body.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "const padded = payload + '='.repeat((4 - payload.length % 4) % 4);",
                  "const claims = JSON.parse(atob(padded));",
                  "pm.test('El token pertenece a un ADMIN', () => {",
                  "  pm.expect(claims.role).to.eql('ADMIN');",
                  "  pm.expect(claims.sub).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Inicia sesión con el administrador y guarda `accessToken` en las variables de la colección."
