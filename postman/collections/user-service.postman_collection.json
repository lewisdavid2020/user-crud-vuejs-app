    {
      "name": "03 · Usuarios (flujo CRUD)",
      "description": "Flujo ordenado: crear, idempotencia, conflicto, listar, consultar, activar, permisos por rol, eliminar y limpiar.",
      "item": [
        {
          "name": "1. Crear usuario MEMBER (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('testUserId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.variables.set('testName', 'Usuario Postman');",
                  "pm.variables.set('testEmail', `postman.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve el usuario creado', () => {",
                  "  ['id', 'name', 'email', 'role', 'status'].forEach((key) => {",
                  "    pm.expect(body).to.have.property(key);",
                  "  });",
                  "  pm.expect(body.role).to.eql('MEMBER');",
                  "  pm.expect(body.status).to.eql('PENDING');",
                  "});",
                  "pm.test('No expone la contraseña', () => {",
                  "  pm.expect(body).to.not.have.property('password');",
                  "});",
                  "",
                  "pm.collectionVariables.set('testUserId', body.id);",
                  "pm.collectionVariables.set('testName', body.name);",
                  "pm.collectionVariables.set('testEmail', body.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{testUserId}}\",\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"MEMBER\"\n}",
